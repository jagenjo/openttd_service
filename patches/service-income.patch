index a82ccc1..44766bf 100644
--- a/src/economy.cpp
+++ b/src/economy.cpp
@@ -962,7 +962,18 @@ Money GetPrice(Price index, uint cost_factor, const GRFFile *grf_file, int shift
 	return cost;
 }
 
+static Money GetBaseTransportedGoodsIncome(uint num_pieces, uint dist, uint16_t transit_periods, CargoType cargo_type);
+
+/**
+ * Income for delivering cargo, scaled by the income percentage of the game (openttd-service).
+ * The setting is part of the savegame, so server and clients always agree.
+ */
 Money GetTransportedGoodsIncome(uint num_pieces, uint dist, uint16_t transit_periods, CargoType cargo_type)
+{
+	return GetBaseTransportedGoodsIncome(num_pieces, dist, transit_periods, cargo_type) * _settings_game.economy.income_percent / 100;
+}
+
+static Money GetBaseTransportedGoodsIncome(uint num_pieces, uint dist, uint16_t transit_periods, CargoType cargo_type)
 {
 	const CargoSpec *cs = CargoSpec::Get(cargo_type);
 	if (!cs->IsValid()) {
@@ -1604,6 +1615,8 @@ static void UpdateLoadUnloadTicks(Vehicle *front, const Station *st, int ticks)
 			ticks += (overhang * ticks) / 8;
 		}
 	}
+	/* openttd-service: loading speed factor of the game (synchronized setting). */
+	ticks = static_cast<int>(static_cast<int64_t>(ticks) * 100 / _settings_game.economy.loading_percent);
 	/* Always wait at least 1, otherwise we'll wait 'infinitively' long. */
 	front->load_unload_ticks = std::max(1, ticks);
 }
