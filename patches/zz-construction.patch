 /**
+ * openttd-service: scale the cost of a top-level construction command by economy.construction_percent.
+ * The setting is part of the savegame, so server and clients agree (also for the cost estimate).
+ * @param res Command result, may be modified.
+ */
+void CommandHelperBase::InternalScaleConstruction(CommandCost &res)
+{
+	if (res.Succeeded()) res.ScaleCostPercent(_settings_game.economy.construction_percent);
+}
