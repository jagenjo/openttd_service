+/** openttd-service: commands whose cost follows economy.construction_percent (tracks, roads, stations). */
+constexpr bool IsServiceConstructionCommand(Commands cmd)
+{
+	switch (cmd) {
+		case CMD_BUILD_RAILROAD_TRACK: case CMD_BUILD_SINGLE_RAIL: case CMD_BUILD_SINGLE_SIGNAL:
+		case CMD_BUILD_SIGNAL_TRACK: case CMD_BUILD_BRIDGE: case CMD_BUILD_TUNNEL:
+		case CMD_BUILD_RAIL_STATION: case CMD_BUILD_RAIL_WAYPOINT: case CMD_BUILD_ROAD_WAYPOINT:
+		case CMD_BUILD_ROAD_STOP: case CMD_BUILD_LONG_ROAD: case CMD_BUILD_ROAD:
+		case CMD_BUILD_AIRPORT: case CMD_BUILD_DOCK:
+			return true;
+		default:
+			return false;
+	}
+}
