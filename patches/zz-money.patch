+/** openttd-service: set the money of a company. Sent as a deity command so every client stays in sync. */
+static bool ConCompanyMoney(std::span<std::string_view> argv)
+{
+	if (argv.size() != 3) {
+		IConsolePrint(CC_HELP, "Set the money of a company. Usage: 'company_money <company-id> <amount>' (base currency, company 1 is 1).");
+		return true;
+	}
+	auto index = ParseCompanyID(argv[1]);
+	auto amount = ParseInteger<int64_t>(argv[2]);
+	if (!index.has_value() || !amount.has_value() || !Company::IsValidID(*index)) {
+		IConsolePrint(CC_ERROR, "Invalid company or amount.");
+		return true;
+	}
+	Money delta = Money(*amount) - Company::Get(*index)->money;
+	Backup<CompanyID> cur_company(_current_company, OWNER_DEITY);
+	Command<CMD_CHANGE_BANK_BALANCE>::Post(TileIndex{}, delta, *index, EXPENSES_OTHER);
+	cur_company.Restore();
+	IConsolePrint(CC_DEFAULT, "Money of company {} set to {}.", index->base() + 1, *amount);
+	return true;
+}
