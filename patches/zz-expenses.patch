 /**
+ * openttd-service: vehicle running costs and infrastructure maintenance follow their own
+ * percentage (economy.maintenance_percent); loan interest follows the cargo income
+ * percentage (economy.income_percent).
+ * @param type Expenses type of the payment.
+ * @param cost Original amount.
+ * @return Scaled amount.
+ */
+static Money ScaleRecurringExpense(ExpensesType type, Money cost)
+{
+	switch (type) {
+		case EXPENSES_TRAIN_RUN:
+		case EXPENSES_ROADVEH_RUN:
+		case EXPENSES_AIRCRAFT_RUN:
+		case EXPENSES_SHIP_RUN:
+		case EXPENSES_PROPERTY:
+			return cost * _settings_game.economy.maintenance_percent / 100;
+		case EXPENSES_LOAN_INTEREST:
+			return cost * _settings_game.economy.income_percent / 100;
+		default:
+			return cost;
+	}
+}
+
+static void SubtractMoneyFromAnyCompany(Company *c, const CommandCost &cost)
+{
+	SubtractMoneyFromAnyCompanyUnscaled(c, CommandCost(cost.GetExpensesType(), ScaleRecurringExpense(cost.GetExpensesType(), cost.GetCost())));
+}
+
+/**
  * Subtract money from the #_current_company, if the company is valid.
  * @param cost Money to pay.
