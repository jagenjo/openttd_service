 /**
+ * openttd-service: when the local company changes, show the player's own area of the map:
+ * the headquarters, else the first station, else the biggest town.
+ * @param company Company the player now controls.
+ */
+static void ServiceScrollToCompany(CompanyID company)
+{
+	if (!Company::IsValidID(company) || FindWindowById(WC_MAIN_WINDOW, 0) == nullptr) return;
+	TileIndex tile = Company::Get(company)->location_of_HQ;
+	if (tile == INVALID_TILE) {
+		for (const Station *st : Station::Iterate()) {
+			if (st->owner == company && st->xy != INVALID_TILE) { tile = st->xy; break; }
+		}
+	}
+	if (tile == INVALID_TILE) {
+		const Town *best = nullptr;
+		for (const Town *t : Town::Iterate()) {
+			if (best == nullptr || t->cache.population > best->cache.population) best = t;
+		}
+		if (best != nullptr) tile = best->xy;
+	}
+	if (tile != INVALID_TILE) ScrollMainWindowToTile(tile, true);
+}
