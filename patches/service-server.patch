+/* openttd-service: action budget and map dump, driven by the web server through the console. */
+/** Number of actions: a non-negative number, or "unlimited" (-1). */
+static std::optional<int32_t> ServiceParseActions(std::string_view arg)
+{
+	if (arg == "unlimited") return -1;
+	return ParseType<int32_t>(arg);
+}
+
+static bool ConActions(std::span<std::string_view> argv)
+{
+	if (argv.empty()) {
+		IConsolePrint(CC_HELP, "Show the actions left of each company. Usage: 'actions'.");
+		return true;
+	}
+	for (const Company *c : Company::Iterate()) {
+		IConsolePrint(CC_DEFAULT, "Actions company {}: {}", c->index.base() + 1, ServiceActionsLeft(c->index));
+	}
+	return true;
+}
+
+static bool ConActionsSet(std::span<std::string_view> argv)
+{
+	if (argv.size() != 3) {
+		IConsolePrint(CC_HELP, "Set the actions left of a company. Usage: 'actions_set <company-id> <n>' ('unlimited', or 'default' for the default).");
+		return true;
+	}
+	auto company = ParseType<uint8_t>(argv[1]);
+	if (!company.has_value() || *company < 1 || *company > MAX_COMPANIES) {
+		IConsolePrint(CC_ERROR, "The given company-id is not valid.");
+		return true;
+	}
+	if (argv[2] == "default") {
+		ServiceActionsSet(CompanyID(*company - 1), INT32_MIN);
+		return true;
+	}
+	auto n = ServiceParseActions(argv[2]);
+	if (!n.has_value()) {
+		IConsolePrint(CC_ERROR, "The given number is not valid.");
+		return true;
+	}
+	ServiceActionsSet(CompanyID(*company - 1), *n);
+	return true;
+}
+
+static bool ConActionsDefault(std::span<std::string_view> argv)
+{
+	if (argv.size() != 2) {
+		IConsolePrint(CC_HELP, "Set the default actions of companies. Usage: 'actions_default <n>' ('unlimited' for no limit).");
+		return true;
+	}
+	auto n = ServiceParseActions(argv[1]);
+	if (!n.has_value()) {
+		IConsolePrint(CC_ERROR, "The given number is not valid.");
+		return true;
+	}
+	ServiceActionsSetDefault(*n);
+	return true;
+}
+
+/** One byte per tile: 0 land, 1 water, 2 house/town road, 3 station, 4 industry, 16 + company index if company-owned. */
+static uint8_t ServiceMapCode(TileIndex tile)
+{
+	switch (GetTileType(tile)) {
+		case MP_VOID: return 1;
+		case MP_HOUSE: return 2;
+		case MP_STATION: return 3;
+		case MP_INDUSTRY: return 4;
+		case MP_WATER: {
+			Owner o = GetTileOwner(tile);
+			return Company::IsValidID(o) ? 16 + o.base() : 1;
+		}
+		case MP_RAILWAY:
+		case MP_ROAD:
+		case MP_TUNNELBRIDGE:
+		case MP_OBJECT: {
+			Owner o = GetTileOwner(tile);
+			if (Company::IsValidID(o)) return 16 + o.base();
+			return o == OWNER_TOWN ? 2 : 0;
+		}
+		default: return 0;
+	}
+}
+
+static bool ConDumpMap(std::span<std::string_view> argv)
+{
+	if (argv.size() != 2) {
+		IConsolePrint(CC_HELP, "Write the map as a file: u32 width, u32 height (little endian) and one byte per tile. Usage: 'dump_map <file>'.");
+		return true;
+	}
+	std::ofstream out(std::string(argv[1]), std::ios::binary | std::ios::trunc);
+	if (!out) {
+		IConsolePrint(CC_ERROR, "Cannot write the file.");
+		return true;
+	}
+	uint32_t size[2] = {Map::SizeX(), Map::SizeY()};
+	for (uint32_t v : size) {
+		char b[4] = {static_cast<char>(v), static_cast<char>(v >> 8), static_cast<char>(v >> 16), static_cast<char>(v >> 24)};
+		out.write(b, 4);
+	}
+	std::vector<char> row(Map::SizeX());
+	for (uint y = 0; y < Map::SizeY(); y++) {
+		for (uint x = 0; x < Map::SizeX(); x++) row[x] = static_cast<char>(ServiceMapCode(TileXY(x, y)));
+		out.write(row.data(), row.size());
+	}
+	IConsolePrint(CC_DEFAULT, "Map written: {}x{}", Map::SizeX(), Map::SizeY());
+	return true;
+}
