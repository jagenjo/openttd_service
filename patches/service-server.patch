+/* openttd-service: per-company budget of build/destroy actions (landscape construction commands). */
+static constexpr int ACTIONS_UNSET = INT32_MIN;
+static std::array<int, MAX_COMPANIES> _service_actions = [] { std::array<int, MAX_COMPANIES> a; a.fill(ACTIONS_UNSET); return a; }();
+static int _service_actions_default = -1;
+
+/** Actions left for a company: -1 if unlimited. */
+int ServiceActionsLeft(CompanyID company)
+{
+	if (company.base() >= MAX_COMPANIES) return -1;
+	int &a = _service_actions[company.base()];
+	return a == ACTIONS_UNSET ? _service_actions_default : a;
+}
+
+void ServiceActionsSet(CompanyID company, int actions)
+{
+	if (company.base() < MAX_COMPANIES) _service_actions[company.base()] = actions;
+}
+
+/** Budget of companies without an explicit value, and of all companies that have not been set yet. */
+void ServiceActionsSetDefault(int actions)
+{
+	_service_actions_default = actions;
+}
+
+/** Spend one action. @return false if the company has none left. */
+bool ServiceActionsConsume(CompanyID company)
+{
+	int left = ServiceActionsLeft(company);
+	if (left < 0) return true;
+	if (left == 0) return false;
+	_service_actions[company.base()] = left - 1;
+	return true;
+}
